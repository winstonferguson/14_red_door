<nav class="tablet">
  <ul>
    <% @collections.each do |collection| %>
      <li>
        <a 
          class="nav-link hover-shuffle <%= @resource.relative_url.include?(collection) ? 'active':'' %>" 
          href="<%= relative_url "/#{collection}" %>" 
        >
          <%= collection %>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
