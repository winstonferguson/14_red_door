<nav class="tablet">
  <ul>
    <% @collections.each do |collection| %>
      <% active_class = @resource.relative_url.include?(collection) ? 'active' : '' %>
      <li>
        <a
          class="nav-link hover-shuffle <%= active_class %>"
          href="<%= relative_url "/#{collection}" %>"
          rel="prefetch"
        >
          <%= collection.capitalize %>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
