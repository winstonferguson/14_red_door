<picture class="picture" data-controller="image-aspect">
  <% sizes = @sizes.empty? ? [320, 640, 960, 1200, 2560] : @sizes %>

  <% sizes.each do |size| %>
    <source
      media="(max-width: <%= size %>px)"
      srcset="<%= relative_url responsive_image_path(@src, width: size) %>"
    />
  <% end %>

  <img
    src="<%= relative_url responsive_image_path(@src, width: 2560, format: 'jpg') %>"
    alt="<%= @alt %>"
  />
</picture>
