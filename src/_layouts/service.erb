---
layout: default
---

<div class="content full-width">
  <div class="intro">
    <h1 class="title"><%= resource.data.title %></h1>
    <div class="buttons">
      <% resource.data.tags.each do |tag| %>
        <span class="button"><%= tag %></span>
      <% end %>
    </div>
  </div>
  <div class="graphic shadows">
    <%= svg "/images/#{ resource.data.image }" %>
  </div>
  <div class="description">
    <%= yield %>
  </div>
</div>
<aside class="aside">
  <div class="container" data-controller="landing">
    <nav class="shaded nav">
      <span class="desktop">Select</span>
      <ul class="links">
        <% collections.services.resources.each do |service|  %>
          <li class="link <%= resource == service ? 'active': '' %>">
            <a class="icon" href="<%= service.relative_url %>" data-turbo="false" ><%= svg "/images/#{ service.data.icon }" %></a>
          </li>
        <% end %>
      </ul>
    </nav>
    <a href="<%= relative_url "/projects?service=#{resource.data.title.downcase}" %>" class="shaded desktop"><span class="projects">View our <%= resource.data.title %> projects</span></a>    
  </div>
 
</aside>
