      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M12.528 11.0001L21.7031 1.90817C22.0973 1.51757 22.0973 0.88456 21.7031 0.493956C21.309 0.103351 20.6702 0.103351 20.276 0.493956L11.1008 9.58586L1.7228 0.292953C1.32862 -0.0976511 0.689818 -0.0976511 0.295636 0.292953C-0.0985454 0.683558 -0.0985454 1.31657 0.295636 1.70717L9.67365 11.0001L0.295636 20.293C-0.0985454 20.6836 -0.0985454 21.3166 0.295636 21.7072C0.492424 21.9022 0.750974 22 1.00952 22C1.26807 22 1.52602 21.9022 1.72341 21.7072L11.1014 12.4143L20.2766 21.5062C20.4734 21.7012 20.7319 21.799 20.9905 21.799C21.249 21.799 21.507 21.7012 21.7044 21.5062C22.0985 21.1156 22.0985 20.4826 21.7044 20.092L12.5292 11.0001H12.528Z" fill="#504949"/>
