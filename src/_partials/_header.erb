    </button>
      <ul class="links">
        <li class="link"><a href="<%= relative_url '/projects' %>">projects</a></li>
        <li class="link"><a href="<%= relative_url '/services' %>">services</a></li>
        <li class="link"><a href="<%= relative_url '/contact' %>">contact</a></li>
      </ul>
    </nav>
  </div>
</header>
