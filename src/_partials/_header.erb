      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="21" viewBox="0 0 32 21" fill="none">
        <path d="M0 1.16667C0 0.522334 0.522334 0 1.16667 0H30.8333C31.4777 0 32 0.522334 32 1.16667C32 1.811 31.4777 2.33333 30.8333 2.33333H1.16667C0.522334 2.33333 0 1.811 0 1.16667Z" fill="#504949"/>
