<header class="header">
  <a href="<%= relative_url '/' %>" class="logo">
    <%= svg '/images/logo.svg' %>
  </a>
  <%= render Shared::Navbar.new(site: site, resource: resource) %>
  <div class="contact tablet">
    <a class="nav-link <%= @resource.relative_url.include?('contact') ? 'active':'' %>" href="<%= relative_url '/contact' %>">Contact</a>
  </div>

  <div class="mobile">
