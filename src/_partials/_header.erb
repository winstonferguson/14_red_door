        <path d="M0 19.8333C0 19.189 0.522334 18.6667 1.16667 18.6667H30.8333C31.4777 18.6667 32 19.189 32 19.8333C32 20.4777 31.4777 21 30.8333 21H1.16667C0.522334 21 0 20.4777 0 19.8333Z" fill="#504949"/>
